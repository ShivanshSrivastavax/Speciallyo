generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  proposals    Proposal[]
}

model Proposal {
  id              String             @id @default(uuid())
  userId          String
  slug            String             @unique
  recipientName   String
  question        String
  icon            String?
  gifUrl          String?
  gifProvider     String?
  spotifyUrl      String?
  loveNote        String?
  buttonAnimation String             @default("evader")
  published       Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos          Photo[]
  responses       ProposalResponse[]
  visitors        Visitor[]

  @@index([userId])
}

model Photo {
  id         String   @id @default(uuid())
  proposalId String
  url        String
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

model ProposalResponse {
  id         String        @id @default(uuid())
  proposalId String
  response   String
  createdAt  DateTime      @default(now())
  proposal   Proposal      @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

model Visitor {
  id         String   @id @default(uuid())
  proposalId String
  userAgent  String?
  device     String?
  country    String?
  createdAt  DateTime @default(now())
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}
